# Local database
DATABASE_URL=jdbc:postgresql://localhost:5432/champion_crm
DATABASE_USERNAME=champion
DATABASE_PASSWORD=champion

# First local admin. Set a strong password before the first run.
APP_BOOTSTRAP_ADMIN_EMAIL=agent@champion.local
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-running
APP_BOOTSTRAP_ADMIN_NAME=Champion Agent

# Base64-encoded 32-byte AES key for encrypting linked Google refresh tokens.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
APP_TOKEN_ENCRYPTION_KEY_BASE64=

# Keep staff-account provisioning admin-only. Set true later if agents may create agents.
ALLOW_AGENT_AGENT_PROVISIONING=false

# Google account linking. Create an OAuth Web Client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
GOOGLE_MAPS_API_KEY=

# Airtable lead mirror. Use a Personal Access Token scoped to this base with record write access.
AIRTABLE_API_URL=https://api.airtable.com/v0
AIRTABLE_PERSONAL_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Make.com custom webhook. The scenario can branch into email and SMS modules.
MAKE_NEW_LEAD_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=

# Local mail delivery through Mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@championoperations.local

# Set true only behind HTTPS in hosting.
SESSION_COOKIE_SECURE=false
